<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!--
    boosteros / the Booster SDK refuse to create their DDS participant unless
    FASTRTPS_DEFAULT_PROFILES_FILE points at an XML containing a participant profile named
    "booster_dds". compose.yaml sets that variable to this file.

    UDP only: this container has its own IPC namespace, so shared memory cannot work with the
    sim anyway. We share the sim's network namespace, so UDP over its loopback just works.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
      <!-- Match the sim: its participants only use 127.0.0.1. Without this our multicast
           discovery goes out eth0 instead of lo and the sim never sees it. -->
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="booster_dds" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>

</profiles>
