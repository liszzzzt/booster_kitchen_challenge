  <!--
    boosteros / the Booster SDK refuse to create their DDS participant unless
    FASTRTPS_DEFAULT_PROFILES_FILE points at an XML containing a participant profile named
    "booster_dds". compose.yaml sets that variable to this file.

    UDP only: this container has its own IPC namespace, so shared memory cannot work with the
    sim anyway. We share the sim's network namespace, so UDP over its loopback just works.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
      <!-- Match the sim: its participants only use 127.0.0.1. Without this our multicast
           discovery goes out eth0 instead of lo and the sim never sees it. -->
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="booster_dds" is_default_profile="true">
    <rtps>
      <!--
        Discovery. Inside the sim, participants find each other over shared memory (SHM), which
        this container cannot use, and multicast does not reach us over loopback. Over UDP Fast DDS
        only greets participant IDs 0..4 by default (ports 7410 + 2*id on domain 0), so a
        participant created late, like the T2 agent's (/t2/... topics), was never discovered.
        Greet IDs 0..119 explicitly; once we greet a participant it answers and both sides match.
      -->
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>239.255.0.1</address><port>7400</port></udpv4></locator>
